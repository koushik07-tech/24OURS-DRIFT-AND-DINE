# ===================================================
# 24OURS — DRIFT AND DINE ENVIRONMENT CONFIGURATION
# ===================================================

# Database (PostgreSQL / Supabase / Neon / Local SQLite)
DATABASE_URL="postgresql://user:password@localhost:5432/drift_and_dine?schema=public"

# Authentication & Sessions
AUTH_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
AUTH_EXPIRES_IN="7d"

# Payment Gateway (Razorpay India)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_never_expose_in_frontend"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Media Storage (Cloudinary / AWS S3)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Maps & Location Services
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_browser_key"

# Email Notifications (Resend / SendGrid)
EMAIL_API_KEY="re_placeholder_email_api_key"
EMAIL_FROM="noreply@24oursdriftanddine.com"

# Server Port
PORT=5000
NODE_ENV="development"
