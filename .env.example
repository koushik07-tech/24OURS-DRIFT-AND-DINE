# ==============================================================================
# 24OURS — DRIFT AND DINE PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure the secrets for your deployment target.
# NEVER commit real production secrets, database credentials, or private keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SERVER-ONLY) [REQUIRED IN PROD & DEV]
# ------------------------------------------------------------------------------
# Direct connection URI for PostgreSQL (Supabase, Neon, AWS RDS, or local Postgres)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/drift_and_dine?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SESSION SECRETS (SERVER-ONLY) [REQUIRED IN PROD]
# ------------------------------------------------------------------------------
# 256-bit cryptographically random string (min 32 characters)
AUTH_SECRET="generate_a_random_32_char_hex_or_base64_secret_for_production"
AUTH_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 3. RAZORPAY INDIA PAYMENT GATEWAY (SERVER-ONLY SECRETS) [REQUIRED IN PROD]
# ------------------------------------------------------------------------------
# Public Key ID (shared with client during checkout initialization)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"

# Private Key Secret (STRICTLY SERVER-ONLY - used for HMAC signature validation)
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_never_expose_to_client"

# Webhook Secret (STRICTLY SERVER-ONLY - configured in Razorpay Dashboard -> Webhooks)
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_for_event_signing"

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL NOTIFICATIONS (SERVER-ONLY) [OPTIONAL IN DEV, RECOMMENDED IN PROD]
# ------------------------------------------------------------------------------
# Resend API key for automated confirmation emails to customer and concierge desk
# If left placeholder, emails are logged in development mode without external calls.
RESEND_API_KEY="re_placeholder_resend_api_key"
EMAIL_FROM="24OURS Concierge <bookings@24oursdriftanddine.com>"
MANAGER_EMAIL="manager@24oursdriftanddine.com"

# ------------------------------------------------------------------------------
# 5. MEDIA & CLOUD STORAGE (SERVER-ONLY) [OPTIONAL]
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ------------------------------------------------------------------------------
# 6. APPLICATION RUNTIME & URLS [REQUIRED IN PROD]
# ------------------------------------------------------------------------------
NODE_ENV="development" # Set to "production" in live deployment
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000" # Set to "https://yourdomain.com" in production
